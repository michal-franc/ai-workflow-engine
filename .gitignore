# Binaries and build output
/issue-viewer
/issue-cli
/cmd/issue-cli/issue-cli
cover.out

# User-specific config
projects.yaml
projects-*.yaml
# The demo's config is part of the repo (`make demo`)
!demo/projects.yaml

# User data (use projects.yaml to point to your issue/doc directories)
/issues/

# Test data
/test-issues/

# Local agent data
.agent-logs/
/retros/
/bugs/
.klaudiush/

# Per-issue dispatch worktrees
/.worktrees/

# Ad-hoc test issues created in the demo project
/demo/issues/test*.md

# Screenshot notes and drafts not used by README or docs
# (tracked screenshots in .images/ stay tracked; add new ones with git add -f)
/.images/
/site/

# Playtest runs: results, logs, screenshots, built binaries
/.playtest/

# Lead handoff notes: private, like /issues/ (owner 2026-10-24)
/sessions/

# Work files live in the private tracker repo (issue-cli tracker init)
/.health/snapshots/
