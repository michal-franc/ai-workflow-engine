projects:

  - name: "My Project"
    slug: "my-project"
    issues: "./issues"
    docs: "./docs"
    # Window opened on a dispatched agent's tmux session; {{session}} is
    # substituted. "none" = headless (the dispatch dialog shows the attach
    # command). Unset = detected when the board starts (docs/agent-dispatch.md).
    # terminal: "kitty tmux attach -t {{session}}"
    # Which model dispatched agents use:
    #   global  (default) - no --model flag; the agent uses its own global settings
    #   project           - enforce agent_models below via --model
    agent_model_source: "project"
    agent_models:
      claude: "claude-opus-5-5"
      # codex: "gpt-5"

  - name: "Another Project"
    slug: "another"
    issues: "/path/to/other/issues"
    docs: "/path/to/other/docs"
