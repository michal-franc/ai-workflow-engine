# Machine-wide defaults, used by every project that doesn't set its own:
# terminal: none                  # a command with {{session}}, or none (never open a terminal)
# tmux_session_per_project: true  # each project's lead and workers share a tmux session named after its slug
# engine_project: issue-viewer      # where `issue-cli report-bug` files issue-cli bugs (default: the project with repo michal-franc/ai-workflow-engine)
#
# One terminal with tmux (e.g. a Mac): set both, then `tmux attach -t <slug>`
# and use prefix s to switch project. See docs/agent-dispatch.md.

projects:

  - name: "My Project"
    slug: "my-project"
    issues: "./issues"
    docs: "./docs"
    # Which model dispatched agents use:
    #   global  (default) - no --model flag; the agent uses its own global settings
    #   project           - enforce agent_models below via --model
    agent_model_source: "project"
    agent_models:
      claude: "claude-opus-5-5"
      # codex: "gpt-5"

  - name: "Another Project"
    slug: "another"
    issues: "/path/to/other/issues"
    docs: "/path/to/other/docs"
